# MAZJ environment variables.
#
# Copy to `.env.local` (git-ignored) and fill in. `.env.local` is the only file
# that should ever hold real values; never commit one.
#
# Validate what you have set without starting the app:   npm run check:env

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Absolute public origin, scheme included, NO trailing slash.
# `lib/site.ts` throws on a production build while this is unset, because every
# canonical, hreflang, og:url, sitemap entry and JSON-LD @id is built from it.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase
#
# All three come from: Supabase dashboard > Project Settings > API Keys
# ---------------------------------------------------------------------------

# Project origin, e.g. https://abcdefghijklmnop.supabase.co
# No trailing slash: supabase-js appends paths to it and a slash yields `//`,
# which PostgREST answers with a 404.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (`sb_publishable_...`), or the legacy `anon` key.
# Safe in a browser by design: it carries no privileges of its own and every
# request it makes is subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 🔴 Secret key (`sb_secret_...`), or the legacy `service_role` key.
#
# THIS KEY BYPASSES ROW LEVEL SECURITY ENTIRELY. It is the database's root
# password wearing a different hat. Never prefix it with NEXT_PUBLIC_, never
# paste it into client code, never log it, never put it in a bug report.
# If it ever leaks, rotate it in the dashboard immediately.
SUPABASE_SECRET_KEY=

# Salt for hashing client IP addresses before they are stored.
#
# A bare IP is personal data under PDPL; a salted hash still supports rate
# limiting and abuse investigation while identifying nobody on its own.
# Rotating this deliberately severs the link to every previously stored hash.
#
#   generate with:   openssl rand -base64 32
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Local tooling only. Never read at runtime.
# ---------------------------------------------------------------------------

# Direct Postgres connection, used by `npm run db:*` for migrations and type
# generation. Found under Project Settings > Database > Connection string.
#
# Note: the direct `db.<ref>.supabase.co` host is IPv6-only. On an IPv4-only
# network use the Supavisor pooler host instead.
SUPABASE_DB_URL=

# Supabase Personal Access Token, from supabase.com/dashboard/account/tokens.
#
# The Supabase CLI and Management API both read this variable by name, so
# `npm run db:*` picks it up automatically. Grants full control of every project
# in your account: treat it exactly like the secret key.
SUPABASE_ACCESS_TOKEN=
