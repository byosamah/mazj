{
  "name": "mazj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server scripts/check-env.mts",
    "db:push": "node scripts/db.mjs push",
    "db:types": "node scripts/db.mjs types",
    "db:types:check": "node scripts/db.mjs types:check",
    "db:diff": "node scripts/db.mjs diff",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "^16.2.10",
    "next-intl": "^4.13.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.38",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
