# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js / build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# testing
/coverage

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets)
.env
.env*.local
.env.*
# ...except the committed template, which holds names and comments, no values.
# Without this negation the `.env.*` line above swallows it and new contributors
# get no record of which variables the app needs.
!.env.example

# deploy / platform
.vercel

# os
.DS_Store
*.pem

# local tooling (machine/user-specific, not source)
.claude.local.md
.claude/settings.local.json
.claude/.cc-writes/
.playwright-mcp/

# stray dev screenshots left in the repo root
/footer-live.png
/footer-live2.png
/hero-live.png

# audit/verification screenshot dumps (session artifacts, not source)
/.audit-shots/

# DESIGN.md extraction artifacts (Playwright captures + computed-token JSON).
# Re-generate with the designmd-ripper skill; DESIGN.md itself IS source.
/.designmd/

# Ad-hoc security probes and their captured responses.
#
# 🔴 Never commit these. The captures taken while verifying the 2026-07-28 admin
# leak were rendered dashboards carrying real customer names, live Rekaz room
# occupancy and subscription totals, and the scripts here read `.env.local` and
# write to the live Rekaz tenant.
.probe/

# Intermediate for the Rekaz report. Regenerate with:
#   python3 scripts/build-rekaz-report.py
# It is ~500KB of base64 font and logo data, and the committed PDF is the
# deliverable. The generator script is the source of truth.
docs/rekaz-api-defect-report.html
